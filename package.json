{
  "name": "linczero-vuepress",
  "description": "Linc's WebSite",
  "version": "1.0.0",
  "license": "GPLv3",
  "type": "module",
  "scripts": {
    "docs:build": "pnpm check-mem && vuepress-vite build src",
    "docs:clean-dev": "vuepress-vite dev src --clean-cache",
    "docs:dev": "vuepress-vite dev src --port 24040",
    "docs:update-package": "pnpm dlx vp-update",
    "check-mem": "node --max-old-space-size=20480 -e 'console.log(v8.getHeapStatistics())'",
    "gen-config": "node ./scripts/generate_config.cjs"
  },
  "devDependencies": {
    "@nolebase/markdown-it-bi-directional-links": "^2.18.2",
    "@vuepress/bundler-vite": "2.0.0-rc.27",
    "@vuepress/plugin-docsearch": "2.0.0-rc.127",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.127",
    "@vuepress/utils": "2.0.0-rc.27",
    "markdown-it": "^14.1.1",
    "markdown-it-any-block": "3.4.4-beta3",
    "markdown-it-container": "^4.0.0",
    "markdown-it-obsidian-callouts": "^0.3.3",
    "markmap-lib": "^0.18.12",
    "markmap-toolbar": "^0.18.12",
    "markmap-view": "^0.18.12",
    "plantuml-encoder": "^1.4.0",
    "sass-embedded": "^1.98.0",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "vuepress": "2.0.0-rc.27",
    "vuepress-theme-hope": "2.0.0-rc.105"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "d3": "^7.9.0",
    "katex": "^0.16.44",
    "mermaid": "^11.13.0"
  }
}
